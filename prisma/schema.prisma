generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model consultations {
  consultation_id       BigInt                  @id @default(autoincrement())
  user_id               BigInt
  title                 String                  @db.VarChar(200)
  status                String?                 @default("active") @db.VarChar(20)
  solution_summary      Json?                   
  messages              Json?                   
  created_at            DateTime?               @default(now()) @db.Timestamp(0)
  updated_at            DateTime?               @default(now()) @db.Timestamp(0)
  completed_at          DateTime?               @db.Timestamp(0)
  users                 users                   @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "consultations_ibfk_1")

  @@index([user_id, created_at(sort: Desc)], map: "idx_user_created")
}

model users {
  user_id        BigInt          @id @default(autoincrement())
  oauth_provider String          @db.VarChar(20)
  oauth_id       String          @db.VarChar(100)
  email          String?         @db.VarChar(255)
  nickname       String?         @db.VarChar(100)
  profile_image  String?         @db.VarChar(500)
  created_at     DateTime?       @default(now()) @db.Timestamp(0)
  updated_at     DateTime?       @default(now()) @db.Timestamp(0)
  last_login_at  DateTime?       @db.Timestamp(0)
  consultations  consultations[]

  @@unique([oauth_provider, oauth_id], map: "unique_oauth")
  @@index([email], map: "idx_email")
}
